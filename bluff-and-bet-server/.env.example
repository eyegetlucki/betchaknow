# ─── SERVER ──────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ─── SUPABASE ────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=change-this-to-a-different-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── STRIPE ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_COINS_STARTER=price_xxx
STRIPE_PRICE_COINS_POPULAR=price_xxx
STRIPE_PRICE_COINS_BEST=price_xxx
STRIPE_PRICE_VIP_MONTHLY=price_xxx

# ─── OAUTH ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-oauth-id
GOOGLE_CLIENT_SECRET=your-google-oauth-secret
DISCORD_CLIENT_ID=your-discord-app-id
DISCORD_CLIENT_SECRET=your-discord-app-secret

# ─── REDIS (optional, for game state) ────────────────────────
REDIS_URL=redis://localhost:6379

# ─── EMAIL (for verification) ────────────────────────────────
EMAIL_FROM=noreply@bluffandbet.com
RESEND_API_KEY=your-resend-api-key
